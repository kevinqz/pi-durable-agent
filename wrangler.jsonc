{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-durable-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "AgentSession" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentSession"] }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": { "APP_ENV": "disabled", "MODEL_MODE": "demo" },
  "env": {
    "local": {
      "name": "pi-durable-agent-local",
      "vars": { "APP_ENV": "local", "MODEL_MODE": "demo" },
      "durable_objects": {
        "bindings": [{ "name": "SESSIONS", "class_name": "AgentSession" }],
      },
      "worker_loaders": [{ "binding": "LOADER" }],
    },
    "staging": {
      "name": "pi-durable-agent-staging",
      "vars": {
        "APP_ENV": "staging",
        "MODEL_MODE": "demo",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
      },
      "durable_objects": {
        "bindings": [{ "name": "SESSIONS", "class_name": "AgentSession" }],
      },
      "worker_loaders": [{ "binding": "LOADER" }],
    },
  },
}
